{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lernapps.net/tooling/schemas/quiz.v1.schema.json",
  "title": "Question bank of a lernapps quiz",
  "description": "The questions of a quiz built from the archetype quiz of @lernapps/tooling, in src/quiz.json. The build validates the bank against this schema and fails with a message naming each problem. Every text is for learners: German, plain language.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "intro", "questions"],
  "properties": {
    "$schema": {
      "description": "This schema, for the editor.",
      "type": "string"
    },
    "title": {
      "description": "The title of the quiz: the page's title and its h1 heading.",
      "$ref": "#/$defs/text"
    },
    "intro": {
      "description": "One or two sentences under the heading: what the quiz is about and whom it is for.",
      "$ref": "#/$defs/text"
    },
    "rememberLastResult": {
      "description": "Keep the last result on the learner's device (localStorage, through the preset's storage) and show it at the end. Off by default: then the quiz stores nothing.",
      "type": "boolean",
      "default": false
    },
    "questions": {
      "description": "The questions, in the order of the page without JavaScript. With JavaScript, the order is shuffled by the seed in the address (?seed=<number>).",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "question": {
      "type": "object",
      "required": ["id", "type", "text", "explanation"],
      "properties": {
        "id": {
          "description": "Stable name of the question, used in its address (#frage-<id>): lower-case letters, digits and hyphens. Keep it when the text changes, so links to the question keep working.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "type": {
          "description": "The kind of question.",
          "enum": ["single-choice", "multiple-choice", "true-false", "number", "ordering", "matching"]
        },
        "text": {
          "description": "The question, complete in itself.",
          "$ref": "#/$defs/text"
        },
        "explanation": {
          "description": "Why the right answer is right, shown with the solutions at the end.",
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "single-choice"
              }
            },
            "required": ["type"]
          },
          "then": {
            "$ref": "#/$defs/choice"
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "multiple-choice"
              }
            },
            "required": ["type"]
          },
          "then": {
            "$ref": "#/$defs/choice"
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "true-false"
              }
            },
            "required": ["type"]
          },
          "then": {
            "$ref": "#/$defs/trueFalse"
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "number"
              }
            },
            "required": ["type"]
          },
          "then": {
            "$ref": "#/$defs/number"
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "ordering"
              }
            },
            "required": ["type"]
          },
          "then": {
            "$ref": "#/$defs/ordering"
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "matching"
              }
            },
            "required": ["type"]
          },
          "then": {
            "$ref": "#/$defs/matching"
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "choice": {
      "type": "object",
      "description": "Single choice: exactly one option is correct. Multiple choice: at least one option is correct, and the learner selects every correct one.",
      "required": ["options"],
      "properties": {
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "correct", "feedback"],
            "properties": {
              "text": {
                "description": "The option as the learner reads it.",
                "$ref": "#/$defs/text"
              },
              "correct": {
                "description": "Whether this option is correct.",
                "type": "boolean"
              },
              "feedback": {
                "description": "Shown when the learner chose this option: for a wrong option, why it is wrong (the misconception behind it); for a correct one, why it is right.",
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "trueFalse": {
      "type": "object",
      "description": "A statement the learner judges as true or false.",
      "required": ["answer", "feedback"],
      "properties": {
        "answer": {
          "description": "Whether the statement is true.",
          "type": "boolean"
        },
        "feedback": {
          "description": "Shown for the learner's choice: for the true and for the false choice.",
          "type": "object",
          "additionalProperties": false,
          "required": ["true", "false"],
          "properties": {
            "true": {
              "$ref": "#/$defs/text"
            },
            "false": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "number": {
      "type": "object",
      "description": "The learner types a number; it counts when it is within the tolerance of the answer. A comma or a point both work as the decimal sign.",
      "required": ["answer", "tolerance"],
      "properties": {
        "answer": {
          "description": "The right number.",
          "type": "number"
        },
        "tolerance": {
          "description": "How far the learner's number may be from the answer and still count; 0 for an exact answer. Match it to the rounding the question asks for.",
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "description": "The unit, shown next to the input, e.g. \"cm\"; the learner does not type it.",
          "$ref": "#/$defs/text"
        }
      }
    },
    "ordering": {
      "type": "object",
      "description": "The learner puts the items in order. Write them in the right order: the page shows them mixed.",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "matching": {
      "type": "object",
      "description": "The learner matches each left entry with its right entry. Write the pairs as they belong together: the page shows the right entries mixed.",
      "required": ["pairs"],
      "properties": {
        "pairs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["left", "right"],
            "properties": {
              "left": {
                "$ref": "#/$defs/text"
              },
              "right": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    }
  }
}
