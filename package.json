{
  "name": "@lernapps/tooling",
  "version": "0.0.0",
  "description": "Shared tooling of the lernapps.net apps and sites: the CLI lernapps, site actions, Renovate preset, guidance for building apps; documentation at https://lernapps.net/tooling/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lernapps/tooling.git"
  },
  "bin": {
    "lernapps": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "archetypes",
    "check/validation-report.v1.schema.json",
    "generator",
    "review/verdict.v1.schema.json",
    "guidance",
    "skills"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./preset": {
      "types": "./archetypes/shared/preset.ts",
      "default": "./dist/preset.mjs"
    },
    "./playwright": {
      "types": "./archetypes/shared/playwright.ts",
      "default": "./dist/playwright.mjs"
    },
    "./storage": {
      "types": "./archetypes/shared/storage.ts",
      "default": "./dist/storage.mjs"
    },
    "./i18n": {
      "types": "./archetypes/shared/i18n.ts",
      "default": "./dist/i18n.mjs"
    },
    "./a11y": {
      "types": "./archetypes/shared/a11y.ts",
      "default": "./dist/a11y.mjs"
    },
    "./lint": {
      "default": "./dist/lint.mjs"
    },
    "./tsconfig.json": "./archetypes/shared/tsconfig.json",
    "./check/validation-report.v1.schema.json": "./check/validation-report.v1.schema.json",
    "./review/verdict.v1.schema.json": "./review/verdict.v1.schema.json",
    "./guidance/AGENTS.md": "./guidance/AGENTS.md",
    "./guidance/plan-template.md": "./guidance/plan-template.md",
    "./guidance/plan-front-matter.v1.schema.json": "./guidance/plan-front-matter.v1.schema.json",
    "./skills/lernapps-app/SKILL.md": "./skills/lernapps-app/SKILL.md",
    "./skills/lernapps-quiz/SKILL.md": "./skills/lernapps-quiz/SKILL.md"
  },
  "scripts": {
    "prepare": "vp pack && vp config --no-agent",
    "lernapps": "node src/cli.ts",
    "check": "npm run --silent lernapps -- check",
    "rules": "node scripts/rules.ts list",
    "verdict": "node scripts/verdict.ts",
    "build": "./scripts/build.sh",
    "check:site": "lernapps-check --site /tooling/",
    "arc42": "arc42 --dir docs/arc42"
  },
  "dependencies": {
    "@lernapps/site": "github:lernapps/lernapps.github.io#bd3ca7cd112220714f6a0db56d098253f913c4cc",
    "axe-core": "4.13.0",
    "playwright": "1.63.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@doctc/arc42": "0.36.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "vite-plus": "1.0.0"
  },
  "peerDependencies": {
    "vite-plus": "1.0.0"
  },
  "peerDependenciesMeta": {
    "vite-plus": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "appTemplates": {
    "repository": "https://github.com/lernapps/app-templates.git",
    "commit": "3a83657b8d7c06ccb487351bb99af09f93d11140",
    "archetypes": [
      "quiz"
    ]
  }
}
