  "scripts": {
    "prepare": "vp pack && vp config --no-agent",
    "lernapps": "node src/cli.ts",
    "check": "npm run --silent lernapps -- check",
    "rules": "node scripts/rules.ts list",
    "verdict": "node scripts/verdict.ts",
    "build": "./scripts/build.sh",
    "check:site": "lernapps-check --site /tooling/",
    "arc42": "arc42 --dir docs/arc42"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "yaml": "2.9.1"
