    "vite-plus": "1.0.0"
  },
  "peerDependenciesMeta": {
    "vite-plus": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
