# The fast part of the checks (format, lint, type check). The staged files are formatted first;
# then the same command as the first half of the CI job `check`. Quiet, like the pre-commit hook of every app
# (archetypes/shared/hooks/pre-commit): the steps print into the log below; on a failure the hook prints one line
# with the step, its exit code and the log.
log=node_modules/.cache/lernapps/pre-commit.log
mkdir -p "$(dirname "$log")"
: >"$log"
step() {
  name=$1
  shift
  echo "\$ $*" >>"$log"
  "$@" >>"$log" 2>&1 && return 0
  code=$?
  echo "lernapps pre-commit: $name failed (exit $code); the full output is in $log" >&2
  exit "$code"
}
step "format the staged files (vp staged)" vp staged
step "the fast checks (lernapps check --pre-commit)" npm run --silent lernapps -- check --pre-commit
